+/**
+ * Shared read queries used by pages (client replacements for the old
+ * server-side prisma calls that fed page props).
+ */
+
+import { getDatabaseSync } from "./store";
+
+/** ACTIVE classes (classNo asc) with subjects + ACTIVE batches — matches buildClassOpts input. */
+export function activeClassesFull() {
+  const db = getDatabaseSync();
+  return db.class
+    .filter((c) => c.status === "ACTIVE")
+    .sort((a, b) => a.classNo - b.classNo)
+    .map((c) => ({
+      ...c,
+      subjects: db.subject.filter((s) => s.classId === c.id).sort((a, b) => (a.name < b.name ? -1 : 1)),
+      batches: db.batch.filter((b) => b.classId === c.id && b.status === "ACTIVE").sort((a, b2) => (a.name < b2.name ? -1 : 1)),
+    }));
+}
+
+/** ACTIVE classes as {id, name}. */
+export function activeClassesSimple() {
+  return getDatabaseSync()
+    .class.filter((c) => c.status === "ACTIVE")
+    .sort((a, b) => a.classNo - b.classNo)
+    .map((c) => ({ id: c.id, name: c.name }));
+}
+
+/** ACTIVE classes with ACTIVE batches {id,name}. */
+export function activeClassesWithBatches() {
+  const db = getDatabaseSync();
+  return db.class
+    .filter((c) => c.status === "ACTIVE")
+    .sort((a, b) => a.classNo - b.classNo)
+    .map((c) => ({
+      ...c,
+      batches: db.batch.filter((b) => b.classId === c.id && b.status === "ACTIVE").sort((a, b2) => (a.name < b2.name ? -1 : 1)).map((b) => ({ id: b.id, name: b.name })),
+    }));
+}
+
+/** ACTIVE teachers as {id, name}. */
+export function activeTeachersSimple() {
+  return getDatabaseSync()
+    .teacher.filter((t) => t.status === "ACTIVE")
+    .sort((a, b) => (a.name < b.name ? -1 : 1))
+    .map((t) => ({ id: t.id, name: t.name }));
+}
+
+/** Teacher assignments of one teacher incl. refs (for allowed combos). */
+export function teacherAssignments(teacherId: string) {
+  const db = getDatabaseSync();
+  return db.teacherAssignment
+    .filter((a) => a.teacherId === teacherId)
+    .map((a) => ({
+      ...a,
+      class: db.class.find((c) => c.id === a.classId) || { name: "?" },
+      subject: db.subject.find((s) => s.id === a.subjectId) || { name: "?" },
+      batch: a.batchId ? db.batch.find((b) => b.id === a.batchId) || null : null,
+    }));
+}
+
+/** Coaching name setting. */
+export function coachingName(): string {
+  return getDatabaseSync().setting.find((s) => s.key === "coaching_name")?.value || "ACTIVE PLUS COACHING";
+}
