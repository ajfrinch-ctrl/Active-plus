+/**
+ * Activity log (browser port of src/lib/activity.ts — same behaviour).
+ */
+
+import { update, uid, nowISO } from "./store";
+import type { ActivityLogRow } from "./types";
+import type { Actor } from "./types";
+
+export async function logActivity(actor: Actor, action: string, module: string, recordId?: string, description?: string): Promise<void> {
+  try {
+    const row: ActivityLogRow = {
+      id: uid(),
+      actorType: actor.role,
+      actorId: actor.id,
+      actorName: actor.name,
+      action,
+      module,
+      recordId: recordId ?? null,
+      description: description ?? null,
+      createdAt: nowISO(),
+    };
+    await update<ActivityLogRow>("activityLog", (rows) => [row, ...rows]);
+  } catch {
+    // logging must never break a request
+  }
+}
