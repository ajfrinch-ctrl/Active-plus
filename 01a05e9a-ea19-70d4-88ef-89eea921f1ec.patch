+    writeSession(actor);
+    await logActivity(actor, "LOGIN", "auth", actor.id, `${role} হিসেবে লগইন`);
+    return ok({ role: actor.role, name: actor.name, code: actor.code });
+  }
+
+  if (r1 === "auth" && r2 === "logout") {
