+++ b/src/lib/localdb/api.ts
@@ -0,0 +1,1854 @@
+/**
+ * ACTIVE PLUS — client-side API.
+ *
+ * GitHub Pages is a static host (no Node server), so every former
+ * `src/app/api/**` route handler now lives here, running in the browser on
+ * top of the IndexedDB store. Request/response shapes, validation messages,
+ * role checks and teacher scoping rules are ported 1:1 from the server code,
+ * which is why the existing UI components work unchanged through `api()` in
+ * `src/components/ui.tsx`.
+ */
+
+import { getDatabase, getDatabaseSync, update, replaceDatabase, uid, nowISO, emptyDatabaseForBackup } from "./store";
+import { readSession, writeSession, destroySession } from "./session";
+import { logActivity } from "./activity";
+import { getTeacherScopeSync, scopeCheck } from "./scope";
+import { examWindowState, attemptRemainingSeconds, computeAttemptResult, autoSubmitStaleAttempts, newAnswer } from "./exam-engine";
+import { studentIdOf } from "@/lib/student-id";
+import { DAYS, todayStr } from "@/lib/utils";
+import { METHODS } from "@/lib/finance";
+import type {
+  Actor,
+  AnswerRow,
+  BatchRow,
+  ClassRow,
+  Database,
+  ExamAttemptRow,
+  ExamQuestionRow,
+  ExamRow,
+  FeeRow,
+  HomeworkRow,
+  NoticeRow,
+  PaymentRow,
+  Role,
+  RoutineRow,
+  StudyContentRow,
+  StudentRow,
+  SubjectRow,
+  TeacherAssignmentRow,
+  TeacherRow,
+} from "./types";
+
+export interface ApiEnvelope<T = unknown> {
+  ok: true;
+  data: T;
+}
+
+export class LocalApiError extends Error {
+  status: number;
+  extra: Record<string, unknown>;
+  constructor(message: string, status = 400, extra: Record<string, unknown> = {}) {
+    super(message);
+    this.status = status;
+    this.extra = extra;
+  }
+}
+
+type Json = Record<string, any>;
+
+/* ============================================================
+ * auth plumbing
+ * ============================================================ */
+
+async function requireRoleApi(...roles: Role[]): Promise<Actor> {
+  await getDatabase(); // ensure seeded
+  const s = readSession();
+  if (!s) throw new LocalApiError("লগইন প্রয়োজন", 401);
+  if (!roles.includes(s.role)) throw new LocalApiError("অনুমতি নেই", 403);
+  const db = getDatabaseSync();
+  if (s.role === "ADMIN") {
+    const u = db.user.find((x) => x.id === s.actorId);
+    if (!u || u.status !== "ACTIVE") throw new LocalApiError("লগইন প্রয়োজন", 401);
+    return { id: u.id, role: "ADMIN", name: u.name || u.username, code: u.username };
+  }
+  if (s.role === "TEACHER") {
+    const t = db.teacher.find((x) => x.id === s.actorId);
+    if (!t || t.status !== "ACTIVE") throw new LocalApiError("লগইন প্রয়োজন", 401);
+    return { id: t.id, role: "TEACHER", name: t.name, code: t.teacherId };
+  }
+  const st = db.student.find((x) => x.id === s.actorId);
+  if (!st || st.status !== "ACTIVE") throw new LocalApiError("লগইন প্রয়োজন", 401);
+  return { id: st.id, role: "STUDENT", name: st.name, code: st.studentId };
+}
+
+async function verifyLogin(role: Role, identifier: string, password: string): Promise<Actor | null> {
+  const bcrypt = (await import("bcryptjs")).default;
+  const db = getDatabaseSync();
+  if (role === "ADMIN") {
+    const u = db.user.find((x) => x.username === identifier.trim());
+    if (!u || u.status !== "ACTIVE") return null;
+    if (!(await bcrypt.compare(password, u.passwordHash))) return null;
+    return { id: u.id, role, name: u.name || u.username, code: u.username };
+  }
+  if (role === "TEACHER") {
+    const t = db.teacher.find((x) => x.teacherId === identifier.trim());
+    if (!t || t.status !== "ACTIVE") return null;
+    if (!(await bcrypt.compare(password, t.passwordHash))) return null;
+    return { id: t.id, role, name: t.name, code: t.teacherId };
+  }
+  const s = db.student.find((x) => x.studentId === identifier.trim());
+  if (!s || s.status !== "ACTIVE") return null;
+  if (!(await bcrypt.compare(password, s.passwordHash))) return null;
+  return { id: s.id, role, name: s.name, code: s.studentId };
+}
+
+/* ============================================================
+ * row enrichment ("include" — same shapes the JSON API returned)
+ * ============================================================ */
+
+const byId = <T extends { id: string }>(rows: T[], id: string | null | undefined) => rows.find((r) => r.id === id) || null;
+
+function classRef(db: Database, id: string | null): ClassRow | null {
+  return byId(db.class, id);
+}
+function batchRef(db: Database, id: string | null): BatchRow | null {
+  return byId(db.batch, id);
+}
+function subjectRef(db: Database, id: string | null): SubjectRow | null {
+  return byId(db.subject, id);
+}
+
+function studentWithRefs(db: Database, s: StudentRow) {
+  return { ...s, class: classRef(db, s.classId), batch: batchRef(db, s.batchId) };
+}
+
+function teacherWithAssignments(db: Database, t: TeacherRow) {
+  return {
+    ...t,
+    assignments: db.teacherAssignment
+      .filter((a) => a.teacherId === t.id)
+      .map((a) => ({ ...a, class: classRef(db, a.classId), subject: subjectRef(db, a.subjectId), batch: batchRef(db, a.batchId) })),
+  };
+}
+
+function examWithRefs(db: Database, e: ExamRow) {
+  return {
+    ...e,
+    class: classRef(db, e.classId),
+    batch: batchRef(db, e.batchId),
+    subject: subjectRef(db, e.subjectId),
+    _count: {
+      questions: db.examQuestion.filter((q) => q.examId === e.id).length,
+      attempts: db.examAttempt.filter((a) => a.examId === e.id).length,
+    },
+  };
+}
+
+function examFull(db: Database, e: ExamRow) {
+  return {
+    ...e,
+    class: classRef(db, e.classId),
+    batch: batchRef(db, e.batchId),
+    subject: subjectRef(db, e.subjectId),
+    questions: db.examQuestion.filter((q) => q.examId === e.id).sort((a, b) => a.sortOrder - b.sortOrder),
+    _count: { attempts: db.examAttempt.filter((a) => a.examId === e.id).length },
+  };
+}
+
+function routineWithRefs(db: Database, r: RoutineRow) {
+  return { ...r, subject: subjectRef(db, r.subjectId), teacher: byId(db.teacher, r.teacherId), class: classRef(db, r.classId), batch: batchRef(db, r.batchId) };
+}
+
+function studyWithRefs(db: Database, s: StudyContentRow) {
+  return { ...s, subject: subjectRef(db, s.subjectId), class: classRef(db, s.classId), batch: batchRef(db, s.batchId) };
+}
+
+function homeworkWithRefs(db: Database, h: HomeworkRow) {
+  return { ...h, subject: subjectRef(db, h.subjectId), class: classRef(db, h.classId), batch: batchRef(db, h.batchId) };
+}
+
+function feeWithRefs(db: Database, f: FeeRow) {
+  const st = db.student.find((s) => s.id === f.studentId);
+  return { ...f, student: st ? studentWithRefs(db, st) : null };
+}
+
+function paymentWithRefs(db: Database, p: PaymentRow) {
+  const st = db.student.find((s) => s.id === p.studentId);
+  return { ...p, student: st ? studentWithRefs(db, st) : null, fee: byId(db.fee, p.feeId) };
+}
+
+function attemptWithRefs(db: Database, a: ExamAttemptRow) {
+  const exam = db.exam.find((e) => e.id === a.examId);
+  const st = db.student.find((s) => s.id === a.studentId);
+  return {
+    ...a,
+    student: st ? { ...st, class: classRef(db, st.classId), batch: batchRef(db, st.batchId) } : null,
+    exam: exam ? { ...exam, subject: subjectRef(db, exam.subjectId), class: classRef(db, exam.classId), batch: batchRef(db, exam.batchId) } : null,
+  };
+}
+
+const contains = (v: unknown, q: string) => String(v ?? "").toLowerCase().includes(q);
+
+/* ============================================================
+ * router
+ * ============================================================ */
+
+export async function localApi<T = Json>(method: string, url: string, body?: unknown): Promise<ApiEnvelope<T>> {
+  await getDatabase();
