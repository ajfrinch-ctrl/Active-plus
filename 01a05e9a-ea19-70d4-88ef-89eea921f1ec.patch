+ *
+ * GitHub Pages is static-only, so the whole application now runs in the
+ * browser: this store replaces the old Prisma/SQLite server database with
+ * the exact same data structure (see ./types.ts ↔ prisma/schema.prisma).
+ *
+ * Layout: one IndexedDB record holds the whole database object. Every
+ * mutation bumps a version counter and notifies subscribers (React hooks),
+ * so pages re-render live when data changes.
+ */
+
+import type { CollectionName, Database } from "./types";
+import { buildSeedDatabase } from "./seed";
+
+const DB_NAME = "active-plus-db";
+const DB_VERSION = 1;
+const STORE = "kv";
+const KEY_DB = "db";
+const KEY_SEED_VERSION = "seedVersion";
+
+/** Bump when the bundled demo seed changes and should re-seed a fresh profile. */
+export const SEED_VERSION = 1;
+
+let dbPromise: Promise<IDBDatabase> | null = null;
+let cached: Database | null = null;
+let version = 0;
+const listeners = new Set<() => void>();
+let broadcast: BroadcastChannel | null = null;
+
+function openDB(): Promise<IDBDatabase> {
+  if (dbPromise) return dbPromise;
+  dbPromise = new Promise((resolve, reject) => {
+    if (typeof indexedDB === "undefined") {
+      reject(new Error("এই ব্রাউজারে স্টোরেজ সাপোর্ট নেই (IndexedDB)"));
+      return;
+    }
+    const req = indexedDB.open(DB_NAME, DB_VERSION);
+    req.onupgradeneeded = () => {
+      const db = req.result;
+      if (!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE);
+    };
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error || new Error("ডাটাবেস খোলা যায়নি"));
+  });
+  return dbPromise;
+}
+
+function idbGet<T>(key: string): Promise<T | undefined> {
+  return openDB().then(
+    (db) =>
+      new Promise<T | undefined>((resolve, reject) => {
+        const tx = db.transaction(STORE, "readonly");
+        const req = tx.objectStore(STORE).get(key);
+        req.onsuccess = () => resolve(req.result as T | undefined);
+        req.onerror = () => reject(req.error);
+      })
+  );
+}
+
+function idbPut(key: string, value: unknown): Promise<void> {
+  return openDB().then(
+    (db) =>
+      new Promise<void>((resolve, reject) => {
+        const tx = db.transaction(STORE, "readwrite");
+        const req = tx.objectStore(STORE).put(value, key);
+        req.onsuccess = () => resolve();
+        req.onerror = () => reject(req.error);
+      })
+  );
+}
+
+function emptyDatabase(): Database {
+  return {
+    user: [],
+    teacher: [],
+    teacherAssignment: [],
+    class: [],
+    batch: [],
+    subject: [],
+    student: [],
+    session: [],
+    routine: [],
+    studyContent: [],
+    homework: [],
+    exam: [],
+    examQuestion: [],
+    examAttempt: [],
+    answer: [],
+    fee: [],
+    payment: [],
+    notice: [],
+    activityLog: [],
+    setting: [],
+  };
+}
+
+/* ---------------- reactive plumbing ---------------- */
+
+function notify(): void {
+  version++;
+  for (const fn of listeners) {
+    try {
+      fn();
+    } catch {
+      /* listener errors must never break a write */
+    }
+  }
+}
+
+/** Subscribe to any data change. Returns an unsubscribe function. */
+export function subscribe(fn: () => void): () => void {
+  listeners.add(fn);
+  return () => listeners.delete(fn);
+}
+
+/** Monotonic change counter (used by useSyncExternalStore). */
+export function getVersion(): number {
+  return version;
+}
+
+/* ---------------- init / seed ---------------- */
+
+let readyPromise: Promise<void> | null = null;
+
+/** Ensure the DB is open and seeded with the demo dataset on first run. */
+export function ready(): Promise<void> {
+  if (readyPromise) return readyPromise;
+  readyPromise = (async () => {
+    // session guard: run only in a real browser
+    if (typeof window === "undefined") return;
+    const existing = await idbGet<Database>(KEY_DB);
+    const seedV = await idbGet<number>(KEY_SEED_VERSION);
+    if (existing && seedV === SEED_VERSION) {
+      cached = { ...emptyDatabase(), ...existing };
+    } else {
+      const seed = buildSeedDatabase();
+      cached = seed;
+      await idbPut(KEY_DB, seed);
+      await idbPut(KEY_SEED_VERSION, SEED_VERSION);
+    }
+    notify();
+    // keep multiple open tabs in sync
+    try {
+      broadcast = broadcast || new BroadcastChannel("active-plus-db");
+      broadcast.onmessage = async () => {
+        const fresh = await idbGet<Database>(KEY_DB);
+        if (fresh) {
+          cached = { ...emptyDatabase(), ...fresh };
+          notify();
+        }
+      };
+    } catch {
+      /* BroadcastChannel unsupported — fine */
+    }
+  })().catch((e) => {
+    readyPromise = null;
+    throw e;
+  });
+  return readyPromise;
+}
+
+/* ---------------- reads ---------------- */
+
+export async function getAll<T = unknown>(name: CollectionName): Promise<T[]> {
+  await ready();
+  return ((cached as Database)[name] || []) as T[];
+}
+
+/** Full database snapshot (used by backup + hooks). */
+export async function getDatabase(): Promise<Database> {
+  await ready();
+  return cached as Database;
+}
+
+/** Synchronous snapshot — only valid after `ready()` has resolved. */
+export function getDatabaseSync(): Database {
+  return (cached || emptyDatabase()) as Database;
+}
+
+/* ---------------- writes ---------------- */
+
+/** Mutate a collection transaction-style: read → change array → persist. */
+export async function update<T>(name: CollectionName, mutate: (rows: T[]) => T[]): Promise<void> {
+  await ready();
+  const db = cached as Database;
+  const rows = (db[name] || []) as T[];
+  db[name] = mutate(rows) as never;
+  await idbPut(KEY_DB, db);
+  notify();
+  try {
+    broadcast?.postMessage("changed");
+  } catch {
+    /* ignore */
+  }
+}
+
+/** Replace the whole database (backup restore / demo reset). */
+export async function replaceDatabase(data: Database): Promise<void> {
+  await ready();
+  const db = { ...emptyDatabase(), ...data };
+  cached = db;
+  await idbPut(KEY_DB, db);
+  await idbPut(KEY_SEED_VERSION, SEED_VERSION);
+  notify();
+  try {
+    broadcast?.postMessage("changed");
+  } catch {
+    /* ignore */
+  }
+}
+
+/** Wipe everything back to the bundled demo dataset. */
+export async function resetToSeed(): Promise<void> {
+  await replaceDatabase(buildSeedDatabase());
+}
+
+/* ---------------- helpers ---------------- */
+
+export function nowISO(): string {
+  return new Date().toISOString();
+}
+
+let uidCounter = 0;
+/** Collision-safe id (same role as Prisma's cuid). */
+export function uid(): string {
+  const rand =
+    typeof crypto !== "undefined" && "getRandomValues" in crypto
+      ? Array.from(crypto.getRandomValues(new Uint8Array(8)))
+          .map((b) => b.toString(16).padStart(2, "0"))
+          .join("")
+      : Math.random().toString(16).slice(2).padEnd(16, "0");
+  return `c${Date.now().toString(16)}${(uidCounter++).toString(16)}${rand}`.slice(0, 25);
+}
+
+export function emptyDatabaseForBackup(): Database {
+  return emptyDatabase();
+}
