@@ -0,0 +1,91 @@
+"use client";
+
+/**
+ * React bindings for the client-side database.
+ * Pages use these the same way they previously used server components +
+ * Prisma: the data function runs against the local store and automatically
+ * re-runs whenever any data changes (live updates after every write).
+ */
+
+import { useEffect, useMemo, useRef, useState, useSyncExternalStore, type ReactNode } from "react";
+import { useRouter } from "next/navigation";
+import { ready, subscribe, getVersion } from "./store";
+import { sessionActor } from "./session";
+import type { Actor, Role } from "./types";
+import { Loading } from "@/components/ui";
+
+/** Re-renders the component whenever the local database changes. */
+export function useDbVersion(): number {
+  return useSyncExternalStore(subscribe, getVersion, () => 0);
+}
+
+/**
+ * Load data from the local store.
+ * `fn` must be a pure reader of the database (use getDatabaseSync()).
+ */
+export function useLocalData<T>(fn: () => T, deps: unknown[] = []): { data: T | null; loading: boolean; error: string } {
+  const version = useDbVersion();
+  const [state, setState] = useState<{ data: T | null; loading: boolean; error: string }>({ data: null, loading: true, error: "" });
+  const fnRef = useRef(fn);
+  fnRef.current = fn;
+
+  useEffect(() => {
+    let alive = true;
+    ready()
+      .then(() => {
+        if (!alive) return;
+        try {
+          setState({ data: fnRef.current(), loading: false, error: "" });
+        } catch (e) {
+          setState({ data: null, loading: false, error: (e as Error).message });
+        }
+      })
+      .catch((e: Error) => {
+        if (alive) setState({ data: null, loading: false, error: e.message });
+      });
+    return () => {
+      alive = false;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [version, ...deps]);
+
+  return state;
+}
+
+/** Current logged-in actor (null once checked and absent). */
+export function useActor(): { actor: Actor | null; checked: boolean } {
+  const [actor, setActor] = useState<Actor | null>(null);
+  const [checked, setChecked] = useState(false);
+  useEffect(() => {
+    ready()
+      .then(() => setActor(sessionActor()))
+      .catch(() => setActor(null))
+      .finally(() => setChecked(true));
+    // re-check when another tab logs in/out (store events cover our own writes)
+    const onFocus = () => setActor(sessionActor());
+    window.addEventListener("focus", onFocus);
+    return () => window.removeEventListener("focus", onFocus);
+  }, []);
+  return { actor, checked };
+}
+
+/**
+ * Role-based access guard (replaces the server middleware + requireRole):
+ * shows a loading state, then renders children only for the allowed role,
+ * otherwise redirects to /login.
+ */
+export function RoleGate({ role, children }: { role: Role | Role[]; children: ReactNode }) {
+  const router = useRouter();
+  const { actor, checked } = useActor();
+  const allowed = useMemo(() => Array.isArray(role) ? role : [role], [role]);
+
+  useEffect(() => {
+    if (checked && (!actor || !allowed.includes(actor.role))) {
+      router.replace("/login");
+    }
+  }, [checked, actor, allowed, router]);
+
+  if (!checked) return <Loading label="যাচাই হচ্ছে..." />;
+  if (!actor || !allowed.includes(actor.role)) return <Loading label="লগইন পেজে যাচ্ছে..." />;
+  return <>{children}</>;
+}
