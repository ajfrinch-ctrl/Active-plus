+    const actor = await requireRoleApi("ADMIN");
+    if (sp.get("confirm") !== "1") fail("রিস্টোর নিশ্চিত করতে ?confirm=1 লাগবে");
+    if (!b || b.app !== "ACTIVE PLUS" || !b.data) fail("ভুল ব্যাকআপ ফাইল");
+    const data = { ...emptyDatabaseForBackup(), ...b.data } as Database;
+    if (!Array.isArray(data.user) || !data.user.length) fail("ভুল ব্যাকআপ ফাইল");
+    await replaceDatabase(data);
+    await logActivity(actor, "BACKUP_RESTORED", "backup", undefined, "ব্যাকআপ থেকে ডেটা পুনরুদ্ধার হয়েছে");
+    return ok({ restored: true });
+  }
+
+  /* ---------------- activity ---------------- */
+  if (r1 === "activity" && m === "GET") {
+    await requireRoleApi("ADMIN");
+    const module = sp.get("module") || "";
+    const page = Math.max(1, Number(sp.get("page") || 1));
+    const limit = 30;
+    let rows = db().activityLog;
+    if (module) rows = rows.filter((l) => l.module === module);
+    rows = [...rows].sort((a, b2) => (a.createdAt < b2.createdAt ? 1 : -1));
+    const total = rows.length;
+    return ok({ logs: rows.slice((page - 1) * limit, page * limit), total, page, pages: Math.max(1, Math.ceil(total / limit)), limit });
+  }
+
+  throw new LocalApiError(`অজানা API: ${m} ${path}`, 404);
+}
+
+/** Build a Date from YYYY-MM-DD + HH:MM in local time (same as lib/utils toLocalDate). */
+function toLocalDateFromParts(dateStr: string, hm: string): Date {
+  const [y, mo, d] = dateStr.split("-").map(Number);
+  const [h, mi] = hm.split(":").map(Number);
+  return new Date(y, (mo || 1) - 1, d || 1, h, mi, 0, 0);
+}
