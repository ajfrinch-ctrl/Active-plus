+/**
+ * ACTIVE PLUS — demo seed data (browser port of prisma/seed.ts).
+ * Same dataset, same demo accounts:
+ *   Admin:   admin / admin123
+ *   Teacher: T-001 / teacher123
+ *   Student: 2026-8-001 / student123
+ */
+
+import type { Database } from "./types";
+
+// bcrypt hashes (cost 10) generated once — identical role to the server seed.
+const ADMIN_HASH = "$2b$10$IMIpzEqbPnJOEYF1iXyCHezafL1tHOcS5YPM2UuEejZw1BYpw66yW"; // admin123
+const TEACHER_HASH = "$2b$10$R1FPct7ZdI6mOAJ3MjwL8e3GH2nuwfwg6VR250tzukxmJ.YL2hZZC"; // teacher123
+const STUDENT_HASH = "$2b$10$3sGBHWFI6UtJZO0Gy27DlO2wsRCmsWXVXw2G7yHmlG4v.1dSOqARm"; // student123
+
+const YEAR = "2026";
+
+function dayStr(offsetDays: number): string {
+  const d = new Date(Date.now() + offsetDays * 24 * 3600 * 1000);
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+}
+
+export function buildSeedDatabase(): Database {
+  const now = new Date().toISOString();
+  const todayStr = dayStr(0);
+  const yStr = dayStr(-1);
+  const tStr = dayStr(1);
+
+  const db: Database = {
+    user: [{ id: "user-admin", username: "admin", passwordHash: ADMIN_HASH, name: "Admin (অ্যাডমিন)", status: "ACTIVE", createdAt: now, updatedAt: now }],
+    teacher: [],
+    teacherAssignment: [],
+    class: [],
+    batch: [],
+    subject: [],
+    student: [],
+    session: [],
+    routine: [],
+    studyContent: [],
+    homework: [],
+    exam: [],
+    examQuestion: [],
+    examAttempt: [],
+    answer: [],
+    fee: [],
+    payment: [],
+    notice: [],
+    activityLog: [],
+    setting: [],
+  };
+
+  // Classes 1-12
+  const classIds: Record<string, string> = {};
+  const classNoMap: Record<string, number> = {};
+  for (let i = 1; i <= 12; i++) {
+    const id = `cls-${i}`;
+    classIds[String(i)] = id;
+    classNoMap[id] = i;
+    db.class.push({ id, name: String(i), classNo: i, academicYear: YEAR, status: "ACTIVE", createdAt: now, updatedAt: now });
+  }
+
+  // Batches: Morning / Day / Evening per class
+  const batchIds: Record<string, string> = {};
+  const batchTimes: Record<string, [string, string]> = { Morning: ["07:00", "08:30"], Day: ["15:00", "16:30"], Evening: ["18:00", "19:30"] };
+  for (const [cls, cid] of Object.entries(classIds)) {
+    for (const [bname, [st, et]] of Object.entries(batchTimes)) {
+      const id = `bat-${cls}-${bname.toLowerCase()}`;
+      batchIds[`${cls}|${bname}`] = id;
+      db.batch.push({ id, name: bname, classId: cid, startTime: st, endTime: et, status: "ACTIVE", createdAt: now, updatedAt: now });
+    }
+  }
+
+  // Subjects
+  const ALL_SUBJECTS = ["বাংলা", "English", "গণিত", "বিজ্ঞান"];
+  const OLD_SUBJECTS = ["ICT", "Physics", "Chemistry"];
+  const subjectIds: Record<string, string> = {};
+  for (const [cls, cid] of Object.entries(classIds)) {
+    for (const s of ALL_SUBJECTS) {
+      const id = `sub-${cls}-${ALL_SUBJECTS.indexOf(s) + 1}`;
+      subjectIds[`${cls}|${s}`] = id;
+      db.subject.push({ id, name: s, classId: cid, createdAt: now, updatedAt: now });
+    }
+    if (Number(cls) >= 6) {
+      for (const s of OLD_SUBJECTS) {
+        const id = `sub-${cls}-${ALL_SUBJECTS.length + OLD_SUBJECTS.indexOf(s) + 1}`;
+        subjectIds[`${cls}|${s}`] = id;
+        db.subject.push({ id, name: s, classId: cid, createdAt: now, updatedAt: now });
+      }
+    }
+  }
+
+  // Teachers + assignments
+  const teacherDefs: { tid: string; name: string; mobile: string; subject: string; classes: string[] }[] = [
+    { tid: "T-001", name: "রফিকুল ইসলাম (Rahman Sir)", mobile: "01711111111", subject: "গণিত", classes: ["8", "10"] },
+    { tid: "T-002", name: "করিম উদ্দিন (Karim Sir)", mobile: "01722222222", subject: "English", classes: ["8"] },
+    { tid: "T-003", name: "ফাতেমা বেগম (Fatema Madam)", mobile: "01733333333", subject: "বিজ্ঞান", classes: ["8"] },
+    { tid: "T-004", name: "সালমা খাতুন (Salma Madam)", mobile: "01744444444", subject: "বাংলা", classes: ["8"] },
+  ];
+  const teacherIds: Record<string, string> = {};
+  for (const t of teacherDefs) {
+    const id = `tch-${t.tid.toLowerCase()}`;
+    teacherIds[t.tid] = id;
+    db.teacher.push({
+      id,
+      teacherId: t.tid,
+      name: t.name,
+      mobile: t.mobile,
+      email: `${t.tid.toLowerCase()}@activeplus.example.com`,
+      photoUrl: null,
+      passwordHash: TEACHER_HASH,
+      status: "ACTIVE",
+      createdAt: now,
+      updatedAt: now,
+    });
+    for (const cls of t.classes) {
+      db.teacherAssignment.push({ id: `asg-${t.tid}-${cls}`, teacherId: id, classId: classIds[cls], subjectId: subjectIds[`${cls}|${t.subject}`], batchId: null });
+    }
+  }
+
+  // Students
