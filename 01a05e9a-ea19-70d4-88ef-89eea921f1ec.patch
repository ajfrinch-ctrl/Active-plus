+++ b/src/lib/base-path.ts
@@ -0,0 +1,11 @@
+/**
+ * GitHub Pages hosts this app at https://<user>.github.io/active-plus/
+ * so every public/ asset and PWA reference must be prefixed.
+ * Keep in sync with `basePath` in next.config.ts.
+ */
+export const BASE_PATH = "/active-plus";
+
+/** Absolute (root-relative) URL for a public asset, e.g. asset("/sw.js"). */
+export function asset(path: string): string {
+  return `${BASE_PATH}/${String(path).replace(/^\//, "")}`;
+}
