diff --git a/src/lib/localdb/session.ts b/src/lib/localdb/session.ts
new file mode 100644
index 0000000..e00fdee
--- /dev/null
+++ b/src/lib/localdb/session.ts
@@ -0,0 +1,61 @@
+/**
+ * ACTIVE PLUS — client-side session.
+ * GitHub Pages has no server, so the session lives in localStorage (tiny +
+ * synchronously readable, unlike the IndexedDB data store). Role/permission
+ * checks on every API call (see api.ts) still guard the data itself.
+ */
+
+import type { Actor, Role } from "./types";
+
+export const SESSION_KEY = "aps_session";
+export const SESSION_DAYS = 7;
+
+export interface StoredSession {
+  token: string;
+  actorId: string;
+  role: Role;
+  name: string;
+  code: string;
+  expiresAt: number; // epoch ms
+}
+
+export function readSession(): StoredSession | null {
+  if (typeof window === "undefined") return null;
+  try {
+    const raw = localStorage.getItem(SESSION_KEY);
+    if (!raw) return null;
+    const s = JSON.parse(raw) as StoredSession;
+    if (!s || !s.token || !s.role || s.expiresAt < Date.now()) return null;
+    return s;
+  } catch {
+    return null;
+  }
+}
+
+export function writeSession(actor: Actor): StoredSession {
+  const token =
+    typeof crypto !== "undefined" && "randomUUID" in crypto
+      ? crypto.randomUUID().replace(/-/g, "") + crypto.randomUUID().replace(/-/g, "")
+      : String(Date.now()) + Math.random().toString(16).slice(2);
+  const s: StoredSession = {
+    token,
+    actorId: actor.id,
+    role: actor.role,
+    name: actor.name,
+    code: actor.code,
+    expiresAt: Date.now() + SESSION_DAYS * 24 * 3600 * 1000,
+  };
+  localStorage.setItem(SESSION_KEY, JSON.stringify(s));
+  return s;
+}
+
+export function destroySession(): void {
+  if (typeof window !== "undefined") localStorage.removeItem(SESSION_KEY);
+}
+
+/** Quick synchronous actor for UI guards (layouts). */
+export function sessionActor(): Actor | null {
+  const s = readSession();
+  if (!s) return null;
+  return { id: s.actorId, role: s.role, name: s.name, code: s.code };
+}
