diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
new file mode 100644
index 0000000..e15e474
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,58 @@
+name: Deploy to GitHub Pages
+
+on:
+  push:
+    branches: ["main", "master", "arena/01a05e74-active-plus", "arena/01a05e9a-active-plus"]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+
+# Allow only one concurrent deployment
+concurrency:
+  group: "pages"
+  cancel-in-progress: true
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+          cache: "npm"
+
+      - name: Setup Pages
+        uses: actions/configure-pages@v5
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Build (static export)
+        run: npm run build
+
+      - name: Verify export output
+        run: |
+          test -f out/index.html || (echo "::error::out/index.html missing — static export failed" && exit 1)
+
+      - name: Upload Pages artifact
+        uses: actions/upload-pages-artifact@v3
+        with:
+          path: out
+
+  deploy:
+    needs: build
+    runs-on: ubuntu-latest
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - name: Deploy to GitHub Pages
+        id: deployment
+        uses: actions/deploy-pages@v4
diff --git a/next.config.ts b/next.config.ts
index 5968ee8..67bff93 100644
--- a/next.config.ts
+++ b/next.config.ts
@@ -1,32 +1,27 @@
 import type { NextConfig } from "next";
 
+/**
+ * GitHub Pages static export configuration.
+ *
+ * The site is served at https://ajfrinch-ctrl.github.io/active-plus/ so:
+ *  - output: "export"   → produces a fully static `out/` directory
+ *  - basePath            → every route/asset lives under /active-plus
+ *  - trailingSlash       → /active-plus/student/ (directory index.html)
+ *  - images.unoptimized  → no Node image optimizer on a static host
+ *
+ * The app is 100% client-side (IndexedDB data layer, see src/lib/localdb/),
+ * which is what makes the static export fully functional.
+ */
 const nextConfig: NextConfig = {
+  output: "export",
+  basePath: "/active-plus",
+  assetPrefix: "/active-plus/",
+  trailingSlash: true,
+  images: { unoptimized: true },
   // Allow the app to be opened through the sandbox/preview proxy host.
   allowedDevOrigins: ["*.e2b.app", "*.arena.ai", "localhost"],
   eslint: { ignoreDuringBuilds: true },
   typescript: { ignoreBuildErrors: false },
-  images: { unoptimized: true },
-  // Prisma + its libSQL driver adapter are native addons: keep them out of the
-  // server bundle so webpack does not try to parse their dynamic requires.
-  serverExternalPackages: [
-    "@prisma/client",
-    "@prisma/adapter-libsql",
-    "@libsql/client",
-    "libsql",
-  ],
-  async headers() {
-    return [
-      {
-        // The browser must always re-check the service worker for updates.
-        source: "/sw.js",
-        headers: [{ key: "Cache-Control", value: "no-cache, no-store, must-revalidate" }],
-      },
-      {
-        source: "/manifest.webmanifest",
-        headers: [{ key: "Cache-Control", value: "no-cache" }],
-      },
-    ];
-  },
 };
 
 export default nextConfig;
