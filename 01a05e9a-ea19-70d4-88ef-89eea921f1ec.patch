-/** POST /api/payments — add payment, auto-update fee, generate unique receipt */
-export async function POST(req: NextRequest) {
-  try {
-    const actor = await requireRoleApi("ADMIN");
-    const b = await req.json().catch(() => ({}));
-    const studentId = String(b.studentId || "");
-    const month = Number(b.month);
-    const year = Number(b.year);
-    const amount = Number(b.amount);
-    const method = String(b.method || "Cash");
-
-    if (!studentId) return fail("শিক্ষার্থী নির্বাচন করুন");
-    if (!year || year < 2000 || year > 2100 || !month || month < 1 || month > 12) return fail("মাস/বছর সঠিক নয়");
-    if (!amount || amount <= 0 || !isFinite(amount)) return fail("পেমেন্টের পরিমাণ সঠিক নয়");
-    if (!METHODS.includes(method)) return fail("পেমেন্ট মাধ্যম সঠিক নয়");
-
-    const student = await prisma.student.findUnique({ where: { id: studentId } });
-    if (!student) return fail("শিক্ষার্থী পাওয়া যায়নি", 404);
-
-    // find or lazily create the fee row for this month
-    let fee = await prisma.fee.findUnique({
-      where: { studentId_month_year: { studentId, month, year } },
-    });
-    if (!fee) {
-      const payable = student.monthlyFee - student.discount;
-      fee = await prisma.fee.create({
-        data: {
-          studentId,
-          month,
-          year,
-          baseAmount: student.monthlyFee,
-          discount: student.discount,
-          payableAmount: payable,
-          paidAmount: 0,
-          dueAmount: payable,
-          status: payable <= 0 ? "PAID" : "UNPAID",
-        },
-      });
-    }
-
-    if (amount > fee.dueAmount + 0.001) {
-      return fail(`অতিরিক্ত পেমেন্ট অনুমোদিত নয় — এই মাসের বাকি ৳${fee.dueAmount.toLocaleString("en-IN")} এর বেশি দেওয়া যাবে না`);
-    }
-
-    // unique receipt number: RC-YYYY-NNNNN
-    const countInYear = await prisma.payment.count({ where: { receiptNo: { startsWith: `RC-${year}-` } } });
-    const receiptNo = `RC-${year}-${String(countInYear + 1).padStart(5, "0")}`;
-
-    const payment = await prisma.payment.create({
-      data: {
-        studentId,
-        feeId: fee.id,
-        receiptNo,
-        paymentDate: String(b.paymentDate || todayStr()),
-        amount,
-        method,
-        transactionId: String(b.transactionId || "") || null,
-        remarks: String(b.remarks || "") || null,
-        receivedBy: String(b.receivedBy || actor.name),
-      },
-      include: { student: { include: { class: true, batch: true } }, fee: true },
-    });
-
-    // update fee
-    const newPaid = fee.paidAmount + amount;
-    const newDue = Math.max(0, fee.payableAmount - newPaid);
-    const status = newDue <= 0 ? "PAID" : "PARTIAL";
-    await prisma.fee.update({ where: { id: fee.id }, data: { paidAmount: newPaid, dueAmount: newDue, status } });
-
-    await logActivity(actor, "PAYMENT_ADDED", "payment", payment.id, `${student.name} — ৳${amount} (${method}) রসিদ ${receiptNo}`);
-    return ok({ payment }, { status: 201 });
-  } catch (e) {
-    return fail((e as Error).message, (e as Error & { status?: number }).status || 500);
-  }
-}
