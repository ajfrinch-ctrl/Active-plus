+/**
+ * Exam engine (browser port of src/lib/exam-engine.ts — identical rules).
+ * The local clock is now the authority (unavoidable on a static host), but
+ * deadlines are still persisted so refresh/re-login cannot reset the timer.
+ */
+
+import { getDatabaseSync } from "./store";
+import { update, uid, nowISO } from "./store";
+import type { AnswerRow, ExamAttemptRow, ExamQuestionRow, ExamRow } from "./types";
+import { toLocalDate } from "@/lib/utils";
+
+export const EXAM_STATUS = {
+  NOT_STARTED: "NOT_STARTED",
+  AVAILABLE: "AVAILABLE",
+  ONGOING: "ONGOING",
+  ENDED: "ENDED",
+  CLOSED: "CLOSED",
+} as const;
+
+export interface ExamWindowState {
+  status: string;
+  now: string;
+  start: string;
+  end: string;
+  canStart: boolean;
+}
+
+export function examWindowState(exam: Pick<ExamRow, "examDate" | "startTime" | "endTime" | "status">): ExamWindowState {
+  const now = new Date();
+  const hm = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`;
+
+  if (exam.status === "CLOSED") return { status: EXAM_STATUS.CLOSED, now: hm, start: exam.startTime, end: exam.endTime, canStart: false };
+  if (exam.status !== "PUBLISHED") return { status: EXAM_STATUS.CLOSED, now: hm, start: exam.startTime, end: exam.endTime, canStart: false };
+
+  const dateStr = exam.examDate || new Date().toISOString().slice(0, 10);
+  const start = toLocalDate(dateStr, exam.startTime);
+  const end = toLocalDate(dateStr, exam.endTime);
+
+  if (now < start) return { status: EXAM_STATUS.NOT_STARTED, now: hm, start: exam.startTime, end: exam.endTime, canStart: false };
+  if (now >= end) return { status: EXAM_STATUS.ENDED, now: hm, start: exam.startTime, end: exam.endTime, canStart: false };
+  return { status: EXAM_STATUS.AVAILABLE, now: hm, start: exam.startTime, end: exam.endTime, canStart: true };
+}
+
+/** Remaining seconds for an attempt (deadline = min(start + duration, window end)). */
+export function attemptRemainingSeconds(attempt: Pick<ExamAttemptRow, "deadline" | "submittedAt" | "status">): number {
+  if (attempt.submittedAt || attempt.status !== "IN_PROGRESS") return 0;
+  return Math.max(0, Math.floor((new Date(attempt.deadline).getTime() - Date.now()) / 1000));
+}
+
+/** Grade a finished attempt: correct × marks, plus per-answer correctness. */
+export async function computeAttemptResult(attemptId: string): Promise<ExamAttemptRow> {
+  const db = getDatabaseSync();
+  const attempt = db.examAttempt.find((a) => a.id === attemptId);
+  if (!attempt) throw new Error("Attempt not found");
+  const questions = db.examQuestion.filter((q) => q.examId === attempt.examId).sort((a, b) => a.sortOrder - b.sortOrder);
+  const answers = db.answer.filter((a) => a.attemptId === attemptId);
+
+  let correct = 0,
+    wrong = 0,
+    unanswered = 0,
+    marks = 0;
+  const totalMarks = questions.reduce((s, q) => s + q.marks, 0);
+
+  const graded: AnswerRow[] = [];
+  for (const q of questions) {
+    const ans = answers.find((a) => a.questionId === q.id);
+    if (!ans) {
+      unanswered++;
+      continue;
+    }
+    if (ans.selectedAnswer === q.correctAnswer) {
+      correct++;
+      marks += q.marks;
+      graded.push({ ...ans, isCorrect: true, marksObtained: q.marks });
+    } else {
+      wrong++;
+      graded.push({ ...ans, isCorrect: false, marksObtained: 0 });
+    }
+  }
+  const percentage = totalMarks > 0 ? (marks / totalMarks) * 100 : 0;
+  const exam = db.exam.find((e) => e.id === attempt.examId);
+  const passed = marks >= (exam?.passMark ?? 0);
+
+  const updated: ExamAttemptRow = {
+    ...attempt,
+    obtainedMarks: marks,
+    totalMarks,
+    percentage,
+    correctCount: correct,
+    wrongCount: wrong,
+    unansweredCount: unanswered,
+    passed,
+    submittedAt: attempt.submittedAt ?? nowISO(),
+    status: attempt.status === "IN_PROGRESS" ? "SUBMITTED" : attempt.status,
+  };
+
+  await update<ExamAttemptRow>("examAttempt", (rows) => rows.map((a) => (a.id === attemptId ? updated : a)));
+  await update<AnswerRow>("answer", (rows) => rows.map((a) => graded.find((g) => g.id === a.id) || a));
+  return updated;
+}
+
+/** Auto-submit every in-progress attempt whose deadline has passed. */
+export async function autoSubmitStaleAttempts(): Promise<number> {
+  const stale = getDatabaseSync()
+    .examAttempt.filter((a) => a.status === "IN_PROGRESS" && new Date(a.deadline).getTime() <= Date.now());
+  for (const a of stale) {
+    await update<ExamAttemptRow>("examAttempt", (rows) =>
+      rows.map((r) => (r.id === a.id ? { ...r, status: "AUTO_SUBMITTED", submittedAt: nowISO() } : r))
+    );
+    await computeAttemptResult(a.id);
+  }
+  return stale.length;
+}
+
+/** Options for a new answer row. */
+export function newAnswer(attemptId: string, questionId: string, selected: string): AnswerRow {
+  return { id: uid(), attemptId, questionId, selectedAnswer: selected, isCorrect: null, marksObtained: 0 };
+}
+
+export type { ExamQuestionRow };
